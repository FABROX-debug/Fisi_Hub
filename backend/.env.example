# PostgreSQL local. Reemplaza solo en tu entorno; no versiones credenciales.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fisihub
DB_USER=postgres
DB_PASSWORD=change-me

# Firma y duracion del JWT.
JWT_SECRET=change-this-for-a-random-secret-with-at-least-32-characters
JWT_EXPIRATION_MS=86400000

# URL permitida del frontend para CORS.
APP_FRONTEND_URL=http://localhost:5173
